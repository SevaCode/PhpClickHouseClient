{
	"name": "seva-code/php-click-house-client",
	"type": "library",
	"description": "PHP Client for ClickHouse HTTP interface",
	"keywords": ["clickhouse"],
	"license": "MIT",
	"authors": [
		{
			"name": "SevaCode"
		}
	],
	"autoload": {
		"psr-4": {
			"SevaCode\\ClickHouseClient\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SevaCode\\ClickHouseClient\\Tests\\": "tests/"
		}
	},
	"require": {
		"php": ">=8.1",
		"psr/log": "^1.1 || ^2.0 || ^3.0",
		"symfony/http-client": "^6.2 || ^7.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"phpstan/phpstan": "^2.1"
	},
	"scripts": {
		"test": "phpunit --testsuite unit",
		"test-integration": "phpunit --testsuite integration",
		"phpstan": "phpstan analyse --memory-limit=512M"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.3.x-dev"
		}
	}
}
